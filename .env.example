# ============================================================
# Конфигурация console-games (.env)
# Скопируйте этот файл в .env: cp .env.example .env
# ============================================================

# 1. Сессионные куки RuTracker (для скачивания magnet и списков файлов)
# Заполняются автоматически через login_rutracker.py или вручную из браузера
# RUTRACKER_COOKIES="bb_session=...; bb_guid=..."

# 2. Локальный или внешний HTTP/SOCKS5 прокси (если RuTracker заблокирован)
# RUTRACKER_PROXY=http://127.0.0.1:12334
# RUTRACKER_PROXY=socks5://127.0.0.1:1080

# 3. Сервис обхода Cloudflare (CloudflareBypassForScraping docker контейнер на VPS)
# RUTRACKER_CF_BYPASS=http://localhost:8000
